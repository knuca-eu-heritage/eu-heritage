{%- set S = db.settings -%}
{%- set pageTitle = (title ~ " — " ~ S.acronym) if title else (S.acronym ~ " — " ~ (S.title | L(lang))) -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or (S.tagline | L(lang)) }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="alternate" hreflang="{{ lang | otherLang }}" href="{{ page.url | swapLang(lang) }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:type" content="website">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">{{ "nav.skip" | t(lang) }}</a>

  <header class="site-head">
    <div class="wrap head-row">
      <a class="brand" href="/{{ lang }}/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M3 3h11v11H3zM18 3h11v11H18zM3 18h11v11H3z" fill="currentColor"/><path class="brand-hl" d="M18 18h11v11H18z"/></svg>
        <span class="brand-text">
          <span class="brand-name">{{ S.acronym }}</span>
          <span class="brand-sub">{{ S.brand_line | L(lang) }}</span>
        </span>
      </a>

      <details class="nav-toggle">
        <summary>{{ "nav.menu" | t(lang) }}</summary>
        {% include "nav.njk" %}
      </details>
      <div class="nav-wide">{% include "nav.njk" %}</div>

      <a class="lang-switch" href="{{ page.url | swapLang(lang) }}" hreflang="{{ lang | otherLang }}" lang="{{ lang | otherLang }}">
        <span aria-hidden="true">{{ "lang.code" | t(lang) }}</span>
        <span class="visually-hidden">{{ "lang.switch" | t(lang) }}</span>
      </a>
    </div>
  </header>

  <main id="main">
    {%- block main %}{% endblock -%}
  </main>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div class="eu-lockup">
        <img src="/assets/img/eu-emblem.svg" alt="" width="81" height="54">
        <p class="eu-funded">{{ "footer.funded" | t(lang) }}</p>
      </div>
      <p class="disclaimer">{{ "footer.disclaimer" | t(lang) }}</p>
      <div class="foot-meta">
        <p><strong>{{ S.acronym }}</strong><br>{{ S.title | L(lang) }}<br>{{ S.project_id | L(lang) }}</p>
        <p>{{ S.institution | L(lang) }}</p>
        <p>{{ "footer.license" | t(lang) }}</p>
        <p class="foot-links">
          <a href="/{{ lang }}/privacy/">{{ "footer.privacy" | t(lang) }}</a>
          <a href="/{{ lang }}/accessibility/">{{ "footer.accessibility" | t(lang) }}</a>
          <a href="/{{ lang }}/contact/">{{ "nav.contact" | t(lang) }}</a>
        </p>
      </div>
    </div>
  </footer>
  {%- if scripts %}{% for s in scripts %}<script src="{{ s }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
