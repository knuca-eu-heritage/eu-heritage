<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and p.url.endsWith("/") %}
  <url><loc>{{ db.settings.site_url }}{{ p.url }}</loc></url>
{%- endif %}{% endfor %}
</urlset>
